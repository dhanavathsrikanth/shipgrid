{
  "mcpServers": {
    "convex-visual": {
      "command": "npx",
      "args": ["convex", "mcp", "start"],
      "env": {
        "CONVEX_MCP_PROJECT_DIR": "."
      }
    },
    "posthog": {
      "url": "https://mcp.posthog.com/mcp",
      "headers": {
        "Authorization": "Bearer <YOUR_POSTHOG_PAT>"
      }
    }
  }
}
